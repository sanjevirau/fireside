{
  "name": "fireside-conformance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/target.test.ts",
    "test:firestore": "node --import tsx --test test/error-code-parity.test.ts test/firestore-smoke.test.ts test/listen.test.ts test/partition-query.test.ts test/query-features.test.ts test/query-ordering.test.ts test/streaming-write.test.ts test/write-transforms.test.ts",
    "test:smoke": "node --import tsx --test test/firestore-smoke.test.ts",
    "test:cloud": "node --import tsx src/run-cloud.ts",
    "test:official": "node --import tsx src/run-official.ts",
    "test:fireside": "node --import tsx src/run-fireside.ts"
  },
  "devDependencies": {
    "@google-cloud/firestore": "9.0.0",
    "@grpc/grpc-js": "1.14.4",
    "@types/node": "26.4.0",
    "firebase-tools": "15.28.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
