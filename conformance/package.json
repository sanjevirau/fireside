{
  "name": "fireside-conformance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/target.test.ts",
    "test:firestore": "node --import tsx --test test/ancestor-collection-group.test.ts test/backend-rpcs.test.ts test/error-code-parity.test.ts test/firestore-smoke.test.ts test/historical-reads.test.ts test/listen.test.ts test/named-database.test.ts test/partition-query.test.ts test/query-explain.test.ts test/query-features.test.ts test/query-ordering.test.ts test/rest.test.ts test/streaming-write.test.ts test/vector-query.test.ts test/write-transforms.test.ts",
    "test:control": "node --import tsx --test test/control-api.test.ts",
    "test:smoke": "node --import tsx --test test/firestore-smoke.test.ts",
    "test:cloud": "node --import tsx src/run-cloud.ts",
    "test:official": "node --import tsx src/run-official.ts",
    "test:fireside": "node --import tsx src/run-fireside.ts",
    "test:fireside:disk": "node --import tsx src/run-fireside.ts --disk",
    "test:fireside:strict": "node --import tsx src/run-fireside.ts --strict-indexes",
    "test:fireside-disk-recovery": "node --import tsx src/test-disk-recovery.ts",
    "test:fireside-import": "node --import tsx src/run-fireside-import.ts",
    "capture:official-export": "node --import tsx src/capture-official-export.ts",
    "test:official-export-import": "node --import tsx src/verify-official-export-import.ts",
    "test:fireside-export-java-import": "node --import tsx src/verify-fireside-export-java-import.ts"
  },
  "devDependencies": {
    "@google-cloud/firestore": "9.0.0",
    "@grpc/grpc-js": "1.14.4",
    "@types/node": "26.4.0",
    "firebase-tools": "15.28.1",
    "google-auth-library": "^11.0.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
